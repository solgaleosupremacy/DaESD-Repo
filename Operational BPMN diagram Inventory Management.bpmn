      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="select-specific-product-05zcmsq" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1a3kai0</bpmn:incoming>
      <bpmn:outgoing>Flow_1x9unhk</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_1x9unhk" sourceRef="Activity_0nf2rrf" targetRef="Activity_14h148p" />
    <bpmn:exclusiveGateway id="Gateway_0l4gstz" name="Is there stock">
      <bpmn:incoming>Flow_007sadc</bpmn:incoming>
      <bpmn:outgoing>Flow_12k4wf4</bpmn:outgoing>
      <bpmn:outgoing>Flow_19nmotw</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_007sadc" sourceRef="Activity_14h148p" targetRef="Gateway_0l4gstz" />
    <bpmn:sequenceFlow id="Flow_12k4wf4" name="No" sourceRef="Gateway_0l4gstz" targetRef="Activity_1s8f8ka">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=no_stock</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_19nmotw" name="Yes" sourceRef="Gateway_0l4gstz" targetRef="Gateway_1elmc0n">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=yes_stock</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_113clnh" sourceRef="Activity_0p8zcrw" targetRef="Event_0d7a4nb" />
    <bpmn:sendTask id="Activity_1s8f8ka" name="Tell producer that there&#39;s no stock">
