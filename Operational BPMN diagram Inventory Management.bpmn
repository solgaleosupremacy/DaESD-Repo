      <bpmn:outgoing>Flow_0n8ki36</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_0divjgv" sourceRef="Event_1scq9nr" targetRef="Activity_0uqpfly" />
    <bpmn:intermediateCatchEvent id="Event_1scq9nr" name="Wait until producer updates stock level">
      <bpmn:incoming>Flow_1yuo5my</bpmn:incoming>
      <bpmn:outgoing>Flow_0divjgv</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="ConditionalEventDefinition_1cjzkyu">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">=wait_for_producer_to_update_stock</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
  </bpmn:process>
