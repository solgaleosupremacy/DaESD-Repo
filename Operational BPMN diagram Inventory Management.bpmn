  <bpmn:process id="Process_09whk22" name="New BPMN diagram" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Login">
      <bpmn:outgoing>Flow_1a3kai0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1a3kai0" sourceRef="StartEvent_1" targetRef="Activity_0nf2rrf" />
