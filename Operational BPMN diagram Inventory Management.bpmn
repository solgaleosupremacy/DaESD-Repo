        <zeebe:taskDefinition type="tell_producer_no_stock" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_12k4wf4</bpmn:incoming>
      <bpmn:outgoing>Flow_1yuo5my</bpmn:outgoing>
