    <bpmn:sequenceFlow id="Flow_1yuo5my" sourceRef="Activity_1s8f8ka" targetRef="Event_1scq9nr" />
    <bpmn:endEvent id="Event_0d7a4nb" name="Stock check completed">
      <bpmn:incoming>Flow_113clnh</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Activity_0p8zcrw" name="Stock is adequate">
